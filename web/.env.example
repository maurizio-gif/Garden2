# Copia questo file in .env.local e compila. Non committare mai .env.local.
#
# Senza SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY il pannello parte con dati di
# prova inventati (c'è un'etichetta «Dati di prova» ben visibile).

# Progetto Supabase di Garden (Settings → API → Project URL)
SUPABASE_URL=https://begzmljfygwkkfjtsyff.supabase.co

# Chiave service_role (Settings → API). Salta le regole RLS: resta SOLO sul server,
# non metterla in nessuna variabile NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Password d'ingresso al pannello (finestra del browser, utente a piacere).
# In produzione è OBBLIGATORIA per mostrare dati veri: senza, il pannello si rifiuta.
DASHBOARD_PASSWORD=
